PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusmarketplace?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated allowed browser origins (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Optional: all three are required on Render for persistent image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=campusmarket
